# A real environment variable wins over this file, and this file wins over the
# built-in defaults. Under Docker **/.env is excluded from the image, so use
# <EveJS root>/config/autoSkyHookDeploy.json (or a service environment entry)
# there instead.
#
# Order of precedence: environment > config/autoSkyHookDeploy.json > this file
# > built-in defaults.

# Master switch. Default: 1. Set to 0 to leave the server exactly as vanilla.
EVEJS_AUTO_SKYHOOK_DEPLOY=1

# Logs each seam and every step of a deploy/remove. Default: 0.
EVEJS_AUTO_SKYHOOK_DEPLOY_VERBOSE=0

# Allow /ash anchor (and !ash anchor). Default: 1.
EVEJS_AUTO_SKYHOOK_DEPLOY_ALLOW_DEPLOY=1

# Allow /ash remove (and !ash remove). Default: 1.
EVEJS_AUTO_SKYHOOK_DEPLOY_ALLOW_REMOVE=1

# Safety cap on one command: a system with more planets than this is refused
# outright, and one remove never processes more skyhook ids than this.
# Range: 1..4096. Default: 64.
EVEJS_AUTO_SKYHOOK_DEPLOY_MAX_PLANETS_PER_COMMAND=64

# A region run is paced, not a burst: mass-creating structures can stall the game.
# Seconds announced before the first system (ticks at 10 s and 5 s; "/ash stop"
# cancels with nothing done). 0 starts at once. Range: 0..120. Default: 15.
EVEJS_AUTO_SKYHOOK_DEPLOY_REGION_COUNTDOWN_SECONDS=15

# Milliseconds waited between systems, after that system has been verified and
# reported. 0 means no delay. Range: 0..60000. Default: 2000.
EVEJS_AUTO_SKYHOOK_DEPLOY_REGION_STEP_DELAY_MS=2000

# How far PAST the planet's landing point the Skyhook is placed, in metres, so a
# ship that warps in does not materialise inside it. 10000 m = 10 km, because the
# structure is large and at 5 km a warp to the planet still landed against it; 0
# puts the Skyhook exactly on the landing point. Adjustable in game: "/ash offset 5km" (or
# 5000m) rewrites offsetMeters in the config JSON itself - that value is read on
# every command, needs no restart, and survives one. Range: 0..100000 (0..100 km).
# Default: 10000.
EVEJS_AUTO_SKYHOOK_DEPLOY_OFFSET_METERS=25000

# FALLBACK PLACEMENT ONLY. A conjured Skyhook is placed on the planet's warp-in
# point - the single spot a warp to that planet always lands on - whenever the
# game has one. Only a body the game has no warp-in point for (radius below
# 90,000 m, an asteroid belt, a wreck) uses the two keys below.
#
# Fallback: how far beyond the planet's SURFACE the Skyhook goes, in metres.
# 5000000 m = 5,000 km, which is where manual deployments from a ship land.
# Range: 100000..100000000 (100 km..100,000 km). Default: 5000000.
EVEJS_AUTO_SKYHOOK_DEPLOY_STANDOFF_METERS=5000000

# Fallback: how many planet radii above the SURFACE the Skyhook goes. The larger
# of this and standoffMeters wins in the fallback. A float. Range: 0..10.
# Default: 1.0 (0 leaves only the standoffMeters floor).
EVEJS_AUTO_SKYHOOK_DEPLOY_ORBIT_MARGIN=1.0

# Who owns a conjured Skyhook: "corporation" (the caller's corporation) or
# "character" (the caller). Default: corporation.
EVEJS_AUTO_SKYHOOK_DEPLOY_OWNER_MODE=corporation

# When 1, a deploy is only allowed into a system whose sovereignty owner
# (corporation or alliance) is the caller's, and only into an already claimed
# system. Default: 0, so a Game Master can conjure Skyhooks anywhere.
EVEJS_AUTO_SKYHOOK_DEPLOY_REQUIRE_CLAIMED_SYSTEM_OWNERSHIP=0

# When 1, /ash status marks a planet whose only record is a destroyed Skyhook as
# "free (destroyed skyhook tombstone - a new one may be placed here)". Default:
# 1. Such planets are deployable either way and are always counted; 0 only drops
# the annotation from the listing.
EVEJS_AUTO_SKYHOOK_DEPLOY_INCLUDE_DESTROYED_IN_STATUS=1
