{
  "schemaVersion": 3,
  "id": "autoSkyHookDeploy",
  "displayName": "Auto Skyhook Deploy",
  "version": "1.1.9",
  "description": "Conjures and removes Orbital Skyhooks (typeID 81080) on any planet of any solar system without an item or a ship. /ash anchor here|<systemID> deploys one Skyhook per free planet just past the planet's warp-in point (offsetMeters, default 25 km, adjustable with /ash offset) and reports the split; /ash remove <skyhookID> destroys one by id; /ash unanchor here|<systemID> destroys every Skyhook in a system; region and system scopes work a whole region (paced, abortable with /ash stop) or one system, skipping NPC space; /ash align moves existing Skyhooks onto the configured offset; /ash status reads the system back per planet; /ash help lists everything. Every subcommand also works as !ash in ordinary chat for characters without staff rights. A planet that already has a live or structure-shaped Skyhook, or a sovereignty ledger row for a real deployment, is never built on twice; a destroyed Skyhook keeps its tombstone and can be replaced. Server-side only; no client change.",
  "kind": "loader",
  "supportedBackends": [
    "native",
    "docker"
  ],
  "activation": {
    "strategy": "loader_rename"
  },
  "restart": "game_server",
  "compatibility": {
    "evejsVersions": [
      "261018.1",
      "261028.1",
      "261108.1",
      "261115.2"
    ]
  },
  "settings": {
    "schemaVersion": 1,
    "files": [
      {
        "id": "settings",
        "base": "mod",
        "path": "settings.json",
        "format": "json"
      }
    ],
    "fields": [
      {
        "id": "offsetMeters",
        "label": "Landing-point offset (m)",
        "type": "number",
        "default": 25000,
        "restart": "game_server",
        "file": "settings",
        "key": [
          "offsetMeters"
        ],
        "minimum": 0,
        "maximum": 100000
      },
      {
        "id": "standoffMeters",
        "label": "Fallback standoff beyond the surface (m)",
        "type": "number",
        "default": 5000000,
        "restart": "game_server",
        "file": "settings",
        "key": [
          "standoffMeters"
        ],
        "minimum": 100000,
        "maximum": 100000000
      },
      {
        "id": "orbitMargin",
        "label": "Fallback orbit margin (planet radii)",
        "type": "number",
        "default": 1.0,
        "restart": "game_server",
        "file": "settings",
        "key": [
          "orbitMargin"
        ],
        "minimum": 0,
        "maximum": 10
      },
      {
        "id": "regionCountdownSeconds",
        "label": "Region run countdown (seconds)",
        "type": "number",
        "default": 15,
        "restart": "game_server",
        "file": "settings",
        "key": [
          "regionCountdownSeconds"
        ],
        "minimum": 0,
        "maximum": 120
      },
      {
        "id": "regionStepDelayMs",
        "label": "Delay between region systems (ms)",
        "type": "number",
        "default": 2000,
        "restart": "game_server",
        "file": "settings",
        "key": [
          "regionStepDelayMs"
        ],
        "minimum": 0,
        "maximum": 60000
      },
      {
        "id": "maxPlanetsPerCommand",
        "label": "Maximum planets per system command",
        "type": "number",
        "default": 64,
        "restart": "game_server",
        "file": "settings",
        "key": [
          "maxPlanetsPerCommand"
        ],
        "minimum": 1,
        "maximum": 4096
      },
      {
        "id": "allowDeploy",
        "label": "Allow /ash anchor",
        "type": "boolean",
        "default": true,
        "restart": "game_server",
        "file": "settings",
        "key": [
          "allowDeploy"
        ]
      },
      {
        "id": "allowRemove",
        "label": "Allow /ash remove and /ash unanchor",
        "type": "boolean",
        "default": true,
        "restart": "game_server",
        "file": "settings",
        "key": [
          "allowRemove"
        ]
      },
      {
        "id": "ownerMode",
        "label": "Owner of a conjured Skyhook (corporation or character)",
        "type": "string",
        "default": "corporation",
        "restart": "game_server",
        "file": "settings",
        "key": [
          "ownerMode"
        ]
      },
      {
        "id": "requireClaimedSystemOwnership",
        "label": "Only work systems the caller's corporation or alliance holds",
        "type": "boolean",
        "default": false,
        "restart": "game_server",
        "file": "settings",
        "key": [
          "requireClaimedSystemOwnership"
        ]
      },
      {
        "id": "includeDestroyedInStatus",
        "label": "List destroyed tombstones in /ash status",
        "type": "boolean",
        "default": true,
        "restart": "game_server",
        "file": "settings",
        "key": [
          "includeDestroyedInStatus"
        ]
      },
      {
        "id": "verbose",
        "label": "Verbose server log",
        "type": "boolean",
        "default": false,
        "restart": "game_server",
        "file": "settings",
        "key": [
          "verbose"
        ],
        "advanced": true
      }
    ]
  },
  "updates": {
    "provider": "github",
    "repository": "HalCyonNJ/EveJS-AutoSkyHookDeploy",
    "asset": "EveJS-AutoSkyHookDeploy-{version}.zip",
    "channel": "stable",
    "tagPrefix": "v",
    "preserveFiles": [
      "settings.json"
    ]
  },
  "launcherApi": {
    "version": 1,
    "helper": {
      "runtime": "node",
      "path": "launcher/helper.js"
    },
    "capabilities": [
      "install",
      "verify",
      "prepare_profile",
      "prepare_disable",
      "prepare_remove",
      "recover"
    ]
  }
}
